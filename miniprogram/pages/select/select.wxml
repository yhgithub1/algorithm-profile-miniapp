<view class="page">
  <view class="card">
    <view class="step">01 / 02</view>
    <view class="h2">给算法 2～5 个线索</view>
    <view class="muted">尽量选择你真实的兴趣和行为，看看这些少量信息能被发散到哪里。</view>

    <view class="tag-list">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag {{selectedMap[item.id] ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggle"
      >
        {{item.label}}
      </view>
    </view>

    <view class="counter">已选择 {{selected.length}} / 5</view>
    <button class="primary" bindtap="generate" disabled="{{selected.length < 2}}">生成我的算法侧写</button>
  </view>
</view>
