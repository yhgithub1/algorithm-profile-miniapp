.step {
  margin-bottom: 14rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.canvas-shell {
  position: relative;
  width: 640rpx;
  height: 1040rpx;
  margin: 24rpx auto;
  overflow: hidden;
  border-radius: 32rpx;
  box-shadow: 0 24rpx 70rpx rgba(17,24,39,.16);
  transform: scale(.96);
  transform-origin: top center;
}

.share-canvas {
  width: 640rpx;
  height: 1040rpx;
  background: #111827;
}

.loading-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(17,24,39,.72);
  font-size: 24rpx;
  font-weight: 700;
}

.action-card {
  margin-top: -10rpx;
}

.share-button {
  margin-top: 16rpx;
  color: #5b21b6;
  background: #f5f3ff;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.share-button::after {
  border: none;
}

.share-note {
  margin-top: 22rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.65;
}

.finish-card {
  background: #111827;
}

.finish-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.finish-flow {
  margin-top: 14rpx;
  color: #cbd5e1;
  font-size: 21rpx;
  line-height: 1.7;
}
