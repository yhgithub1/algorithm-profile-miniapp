.hero-card {
  padding: 38rpx;
  color: #ffffff;
  background: #262624;
  border-radius: 30rpx;
}

.eyebrow {
  color: #b9b6ae;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.28;
}

.desc {
  margin-top: 18rpx;
  color: #d5d2cb;
  font-size: 23rpx;
  line-height: 1.7;
}

.merge-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 2rpx solid #e7e3db;
  border-radius: 26rpx;
}

.merge-kicker {
  color: #6d6a63;
  font-size: 20rpx;
  font-weight: 800;
}

.merge-title {
  margin-top: 7rpx;
  color: #1f1f1d;
  font-size: 29rpx;
  font-weight: 900;
}

.merge-desc {
  margin-top: 8rpx;
  color: #85827b;
  font-size: 21rpx;
  line-height: 1.55;
}

.merge-arrow,
.arrow {
  flex: none;
  color: #8b877f;
  font-size: 34rpx;
  font-weight: 800;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #34332f;
  font-size: 27rpx;
  font-weight: 900;
}

.platform-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #ebe7df;
  border-radius: 24rpx;
}

.platform-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.platform-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: 42rpx;
}

.platform-main {
  flex: 1;
  min-width: 0;
}

.platform-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.platform-name {
  color: #191918;
  font-size: 28rpx;
  font-weight: 900;
}

.view-name {
  margin-top: 4rpx;
  color: #8d8982;
  font-size: 18rpx;
  font-weight: 800;
}

.done-badge {
  flex: none;
  padding: 5rpx 10rpx;
  color: #416a59;
  background: #edf4ef;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 800;
}

.platform-subtitle {
  margin-top: 10rpx;
  color: #77746e;
  font-size: 20rpx;
  line-height: 1.58;
}

.observe-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.observe-chips text {
  padding: 6rpx 10rpx;
  color: #64615b;
  background: #f4f2ed;
  border-radius: 999rpx;
  font-size: 17rpx;
}

.result-preview {
  margin-top: 12rpx;
  color: #5e5a54;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.55;
}

.merge-explain {
  margin-top: 24rpx;
  padding: 26rpx;
  background: #f3f1ec;
  border: 2rpx solid #e7e3db;
  border-radius: 24rpx;
}

.merge-explain-title {
  color: #262522;
  font-size: 25rpx;
  font-weight: 900;
}

.merge-explain-text {
  margin-top: 10rpx;
  color: #74716a;
  font-size: 21rpx;
  line-height: 1.72;
}

.privacy-note {
  margin: 26rpx 10rpx 10rpx;
  color: #9a9790;
  font-size: 19rpx;
  line-height: 1.65;
  text-align: center;
}
