.hero-card {
  padding: 38rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #111827, #312e81);
  border-radius: 30rpx;
}

.eyebrow {
  color: #c7d2fe;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.28;
}

.desc {
  margin-top: 18rpx;
  color: #dbe4ff;
  font-size: 23rpx;
  line-height: 1.7;
}

.merge-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 2rpx solid #e9e5ff;
  border-radius: 26rpx;
}

.merge-kicker {
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 800;
}

.merge-title {
  margin-top: 7rpx;
  color: #111827;
  font-size: 29rpx;
  font-weight: 900;
}

.merge-desc {
  margin-top: 8rpx;
  color: #7c8592;
  font-size: 21rpx;
  line-height: 1.55;
}

.merge-arrow,
.arrow {
  flex: none;
  color: #7c3aed;
  font-size: 36rpx;
  font-weight: 800;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #334155;
  font-size: 27rpx;
  font-weight: 900;
}

.platform-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #eef2f7;
  border-radius: 24rpx;
}

.platform-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: 42rpx;
}

.platform-main {
  flex: 1;
  min-width: 0;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.platform-name {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.done-badge {
  padding: 5rpx 10rpx;
  color: #166534;
  background: #dcfce7;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 800;
}

.platform-subtitle {
  margin-top: 8rpx;
  color: #7c8592;
  font-size: 20rpx;
  line-height: 1.55;
}

.result-preview {
  margin-top: 10rpx;
  color: #5b21b6;
  font-size: 19rpx;
  font-weight: 700;
}

.advanced-card {
  margin-top: 30rpx;
  padding: 28rpx;
  background: #f8fafc;
  border-radius: 24rpx;
}

.advanced-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 900;
}

.advanced-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.65;
}

.advanced-link {
  margin-top: 14rpx;
  color: #7c3aed;
  font-size: 21rpx;
  font-weight: 800;
}

.privacy-note {
  margin: 26rpx 10rpx 10rpx;
  color: #94a3b8;
  font-size: 19rpx;
  line-height: 1.65;
  text-align: center;
}
