.hero {
  padding-top: 54rpx;
  background: linear-gradient(160deg, #ffffff 0%, #ffffff 58%, #f5f3ff 100%);
}

.eyebrow {
  display: inline-block;
  margin-bottom: 22rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.intro {
  margin-top: 24rpx;
}

.hero-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 30rpx;
  padding: 18rpx;
  color: #475569;
  background: #f8fafc;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-flow view {
  padding: 8rpx 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.hero-flow text {
  color: #a78bfa;
}

.journey-card {
  margin-top: 22rpx;
}

.journey-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 900;
}

.journey-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #eef2f7;
}

.journey-row:last-child {
  border-bottom: none;
}

.journey-no {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  color: #7c3aed;
  background: #f5f3ff;
  border-radius: 18rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 60rpx;
}

.journey-name {
  color: #334155;
  font-size: 24rpx;
  font-weight: 800;
}

.journey-desc {
  margin-top: 7rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.55;
}

.notice {
  margin: 24rpx 0 8rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 21rpx;
  line-height: 1.65;
}
