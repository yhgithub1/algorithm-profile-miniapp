.home-page {
  min-height: 100vh;
  padding: 32rpx 30rpx 54rpx;
  box-sizing: border-box;
  color: #28231f;
  background: #f5f2ec;
}

.hero {
  padding: 30rpx 8rpx 18rpx;
}

.eyebrow {
  color: #8d857d;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: -.5rpx;
}

.hero-title.muted {
  margin-top: 2rpx;
  color: #6f675f;
}

.hero-desc {
  margin-top: 20rpx;
  max-width: 640rpx;
  color: #827a72;
  font-size: 22rpx;
  line-height: 1.72;
}

.hero-stage {
  position: relative;
  height: 390rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.halo {
  position: absolute;
  left: 50%;
  top: 52%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  filter: blur(32rpx);
}

.halo-a {
  width: 280rpx;
  height: 210rpx;
  margin-left: -36rpx;
  background: rgba(240,180,41,.13);
}

.halo-b {
  width: 230rpx;
  height: 190rpx;
  margin-left: 48rpx;
  background: rgba(119,104,216,.11);
}

.home-person {
  position: absolute;
  left: 50%;
  top: 42rpx;
  width: 170rpx;
  height: 300rpx;
  transform: translateX(-50%);
  animation: homeFloat 5.5s ease-in-out infinite;
}

.home-head,
.home-neck,
.home-body,
.home-arm,
.home-leg {
  position: absolute;
  background: linear-gradient(145deg, rgba(255,255,255,.99), rgba(228,224,217,.95));
  border: 2rpx solid rgba(124,115,106,.09);
  box-shadow: inset -10rpx -12rpx 22rpx rgba(100,91,83,.05), 0 14rpx 36rpx rgba(80,72,64,.06);
}

.home-head {
  left: 57rpx;
  top: 0;
  width: 58rpx;
  height: 68rpx;
  border-radius: 48% 48% 44% 44%;
}

.home-neck {
  left: 72rpx;
  top: 61rpx;
  width: 28rpx;
  height: 31rpx;
  border-radius: 10rpx;
}

.home-body {
  left: 39rpx;
  top: 84rpx;
  width: 92rpx;
  height: 128rpx;
  border-radius: 46rpx 46rpx 34rpx 34rpx;
}

.home-arm {
  top: 93rpx;
  width: 29rpx;
  height: 116rpx;
  border-radius: 17rpx;
}

.home-arm.left { left: 18rpx; transform: rotate(7deg); }
.home-arm.right { right: 17rpx; transform: rotate(-7deg); }

.home-leg {
  top: 198rpx;
  width: 35rpx;
  height: 96rpx;
  border-radius: 19rpx;
}

.home-leg.left { left: 47rpx; }
.home-leg.right { right: 46rpx; }

.trace-dot {
  position: absolute;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  box-shadow: 0 0 20rpx rgba(255,255,255,.72);
  animation: pulse 3s ease-in-out infinite;
}

.dot-a { left: 26%; top: 42%; background: #f0b429; }
.dot-b { right: 24%; top: 35%; background: #7768d8; animation-delay: .7s; }
.dot-c { right: 30%; bottom: 22%; background: #ef6a64; animation-delay: 1.2s; }

.stage-copy {
  margin-top: -4rpx;
  color: #978f87;
  font-size: 19rpx;
  text-align: center;
}

.start-button {
  height: 94rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #2b2825;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 94rpx;
  letter-spacing: .3rpx;
  box-shadow: 0 16rpx 36rpx rgba(52,46,41,.12);
}

.start-button::after { border: none; }

.resume-link {
  margin-top: 16rpx;
  color: #6f675f;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.idea-card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: rgba(255,255,255,.78);
  border: 2rpx solid rgba(116,107,99,.10);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 38rpx rgba(78,70,62,.04);
}

.idea-kicker {
  margin-bottom: 8rpx;
  color: #766e66;
  font-size: 19rpx;
  font-weight: 800;
}

.idea-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eee9e2;
}

.idea-row:last-child { border-bottom: none; }

.idea-num {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  color: #6c645c;
  background: #eee9e2;
  border-radius: 14rpx;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.idea-title {
  color: #312d29;
  font-size: 23rpx;
  font-weight: 900;
}

.idea-desc {
  margin-top: 7rpx;
  color: #8c847c;
  font-size: 19rpx;
  line-height: 1.58;
}

.closing-copy {
  margin: 34rpx 16rpx 0;
  color: #4b4540;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.55;
  text-align: center;
}

.notice {
  margin: 20rpx 14rpx 0;
  color: #a09890;
  font-size: 17rpx;
  line-height: 1.62;
  text-align: center;
}

@keyframes homeFloat {
  0%, 100% { transform: translateX(-50%) translateY(0) rotate(-.6deg); }
  50% { transform: translateX(-50%) translateY(-7rpx) rotate(.6deg); }
}

@keyframes pulse {
  0%, 100% { opacity: .42; transform: scale(.85); }
  50% { opacity: .9; transform: scale(1.15); }
}
