.hero {
  padding: 42rpx 34rpx 34rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #111827 0%, #312e81 58%, #5b21b6 100%);
  border-radius: 30rpx;
}

.eyebrow {
  display: inline-block;
  padding: 8rpx 14rpx;
  color: #ddd6fe;
  background: rgba(255,255,255,.12);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.h1 {
  margin-top: 20rpx;
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.3;
}

.intro {
  margin-top: 20rpx;
  color: #e0e7ff;
  font-size: 23rpx;
  line-height: 1.72;
}

.app-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.app-pill {
  padding: 9rpx 13rpx;
  color: #f5f3ff;
  background: rgba(255,255,255,.11);
  border-radius: 999rpx;
  font-size: 19rpx;
}

.app-pill text {
  margin-right: 4rpx;
}

.start {
  margin-top: 30rpx;
  background: #ffffff !important;
  color: #312e81 !important;
}

.story-card {
  margin-top: 22rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 26rpx;
}

.story-kicker {
  margin-bottom: 10rpx;
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 900;
}

.story-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.story-row:last-child {
  border-bottom: none;
}

.story-num {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  color: #5b21b6;
  background: #f3e8ff;
  border-radius: 16rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
}

.story-title {
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
}

.story-desc {
  margin-top: 6rpx;
  color: #7c8592;
  font-size: 20rpx;
  line-height: 1.55;
}

.advanced {
  margin-top: 22rpx;
  padding: 28rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 24rpx;
}

.advanced-kicker {
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
}

.advanced-title {
  margin-top: 8rpx;
  color: #111827;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.45;
}

.advanced-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.6;
}

.advanced-link {
  margin-top: 13rpx;
  color: #7c3aed;
  font-size: 21rpx;
  font-weight: 900;
}

.notice {
  margin: 24rpx 10rpx 8rpx;
  color: #94a3b8;
  font-size: 19rpx;
  line-height: 1.65;
  text-align: center;
}
