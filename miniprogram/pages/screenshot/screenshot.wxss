.hero {
  padding: 34rpx;
  border-radius: 30rpx;
}

.hero-icon {
  font-size: 50rpx;
}

.hero-kicker {
  margin-top: 14rpx;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #111827;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.7;
}

.privacy-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  color: #7c2d12;
  background: #fff7ed;
  border: 2rpx solid #fed7aa;
  border-radius: 22rpx;
}

.privacy-title {
  font-size: 23rpx;
  font-weight: 900;
}

.privacy-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.65;
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin: 34rpx 0 18rpx;
}

.section-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.55;
}

.count {
  flex: none;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 800;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.image-item,
.add-image {
  position: relative;
  height: 216rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.image-item {
  background: #e5e7eb;
}

.thumb {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #ffffff;
  background: rgba(17, 24, 39, .72);
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 42rpx;
}

.image-index {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 5rpx 10rpx;
  color: #ffffff;
  background: rgba(17, 24, 39, .72);
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 800;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  font-size: 20rpx;
}

.plus {
  margin-bottom: 8rpx;
  color: #475569;
  font-size: 46rpx;
  line-height: 1;
}

.analyze-button {
  margin-top: 24rpx;
}

.progress-text {
  margin-top: 14rpx;
  color: #7c3aed;
  font-size: 21rpx;
  font-weight: 800;
  text-align: center;
}

.error-card {
  margin-top: 18rpx;
  padding: 20rpx;
  color: #991b1b;
  background: #fff1f2;
  border: 2rpx solid #fecdd3;
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 1.6;
}

.result-wrap {
  margin-top: 34rpx;
}

.result-hero {
  padding: 30rpx;
}

.result-kicker {
  font-size: 20rpx;
  font-weight: 900;
}

.result-title {
  margin-top: 9rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
}

.result-summary {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.7;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.tag-chip {
  padding: 8rpx 14rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.result-section {
  margin: 30rpx 0 14rpx;
}

.category-card,
.evidence-card,
.impact-card {
  padding: 26rpx;
}

.category-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 46rpx;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
}

.category-name {
  color: #334155;
  font-size: 21rpx;
  font-weight: 800;
}

.category-bar {
  height: 12rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.category-fill {
  height: 100%;
  border-radius: 999rpx;
}

.category-count {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 900;
  text-align: right;
}

.evidence-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.evidence-row:last-child {
  border-bottom: none;
}

.evidence-label {
  color: #64748b;
  font-size: 20rpx;
}

.evidence-value {
  flex: 1;
  color: #111827;
  font-size: 21rpx;
  font-weight: 800;
  text-align: right;
}

.impact-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
}

.impact-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 11rpx;
  border-radius: 50%;
}

.impact-text {
  color: #475569;
  font-size: 21rpx;
  line-height: 1.65;
}

.method-card {
  margin: 28rpx 0;
  padding: 24rpx;
  background: #111827;
  border-radius: 22rpx;
}

.method-title {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.method-text {
  margin-top: 10rpx;
  color: #cbd5e1;
  font-size: 20rpx;
  line-height: 1.65;
}
