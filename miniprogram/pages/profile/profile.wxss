.step {
  margin-bottom: 14rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
}

.summary-number {
  font-size: 46rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 8rpx;
  color: #7c8592;
  font-size: 23rpx;
}

.summary-divider {
  width: 2rpx;
  height: 74rpx;
  background: #edf0f4;
}

.layer-title {
  margin: 30rpx 0 18rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 700;
}

.node-card {
  position: relative;
  padding: 28rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border: 2rpx solid #eef1f5;
  border-radius: 24rpx;
}

.node-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #cbd5e1;
}

.depth-1::before { background: #6366f1; }
.depth-2::before { background: #8b5cf6; }
.depth-3::before { background: #a78bfa; }

.node-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.depth-label {
  color: #94a3b8;
  font-size: 21rpx;
  font-weight: 700;
}

.node-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.score {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.confidence-track {
  height: 12rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.confidence-fill {
  height: 100%;
  background: #111827;
  border-radius: 999rpx;
}

.reason {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.disclaimer {
  margin-top: 28rpx;
}

.disclaimer-title {
  margin-bottom: 10rpx;
  font-weight: 700;
}
