.step {
  margin-bottom: 14rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.intro-card {
  margin-bottom: 20rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
}

.summary-number {
  font-size: 42rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 8rpx;
  color: #7c8592;
  font-size: 21rpx;
}

.summary-divider {
  width: 2rpx;
  height: 68rpx;
  background: #edf0f4;
}

.graph-card {
  padding: 0;
  overflow: hidden;
}

.graph-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 0;
}

.layer-title,
.detail-title {
  color: #334155;
  font-size: 28rpx;
  font-weight: 800;
}

.graph-subtitle,
.detail-subtitle {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.replay-button,
.reset-button {
  min-width: 116rpx;
  height: 58rpx;
  padding: 0 20rpx;
  margin: 0;
  color: #475569;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.replay-button::after,
.reset-button::after,
.feedback-button::after {
  border: none;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 30rpx 20rpx;
  color: #64748b;
  font-size: 21rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.input-dot {
  background: #111827;
}

.inference-dot {
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
}

.dimension-dot {
  background: #f3e8ff;
  border: 2rpx solid #a855f7;
}

.graph-scroll {
  width: 100%;
  border-top: 2rpx solid #f1f5f9;
  border-bottom: 2rpx solid #f1f5f9;
  background: #f8fafc;
}

.graph-canvas {
  display: block;
  background: #f8fafc;
}

.graph-status {
  padding: 18rpx 30rpx 22rpx;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 700;
}

.graph-status.done {
  color: #64748b;
}

.persona-card {
  margin-top: 24rpx;
  padding: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #111827 0, #111827 260rpx, #ffffff 260rpx, #ffffff 100%);
}

.persona-kicker {
  color: #a5b4fc;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.persona-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
}

.persona-summary {
  min-height: 76rpx;
  margin-top: 14rpx;
  color: #d1d5db;
  font-size: 23rpx;
  line-height: 1.65;
}

.persona-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  color: #cbd5e1;
  font-size: 20rpx;
}

.persona-progress {
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  background: rgba(255,255,255,.16);
  border-radius: 999rpx;
}

.persona-progress-fill {
  height: 100%;
  background: #a78bfa;
  border-radius: 999rpx;
}

.corrected-banner {
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  color: #166534;
  background: #f0fdf4;
  border: 2rpx solid #bbf7d0;
  border-radius: 18rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.55;
}

.dimension-list {
  margin-top: 46rpx;
}

.dimension-row {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #eef2f7;
}

.dimension-row:last-child {
  border-bottom: none;
}

.dimension-inactive {
  opacity: .48;
}

.dimension-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.dimension-name {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 800;
}

.dimension-desc {
  margin-top: 6rpx;
  color: #7c8592;
  font-size: 21rpx;
}

.dimension-score {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
}

.dimension-track {
  position: relative;
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.dimension-mid {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: -2rpx;
  bottom: -2rpx;
  width: 2rpx;
  background: #cbd5e1;
}

.dimension-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: #8b5cf6;
  border-radius: 999rpx;
}

.dimension-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 18rpx;
}

.dimension-evidence {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.evidence-chip {
  padding: 8rpx 12rpx;
  color: #5b21b6;
  background: #f5f3ff;
  border-radius: 999rpx;
  font-size: 18rpx;
}

.persona-note {
  margin-top: 16rpx;
  padding: 20rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 1.65;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin: 34rpx 0 18rpx;
}

.node-card {
  position: relative;
  padding: 28rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border: 2rpx solid #eef1f5;
  border-radius: 24rpx;
  transition: all .2s ease;
}

.node-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #cbd5e1;
}

.depth-1::before { background: #6366f1; }
.depth-2::before { background: #8b5cf6; }
.depth-3::before { background: #a855f7; }

.node-card.feedback-accurate {
  border-color: #bbf7d0;
  background: #fbfffc;
}

.node-card.feedback-unsure {
  border-color: #fde68a;
  background: #fffdf7;
}

.node-card.feedback-inaccurate {
  border-color: #fecaca;
  background: #fffafa;
}

.node-card.feedback-accurate::before { background: #22c55e; }
.node-card.feedback-unsure::before { background: #f59e0b; }
.node-card.feedback-inaccurate::before { background: #ef4444; }

.node-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.node-main {
  flex: 1;
  min-width: 0;
}

.depth-label {
  color: #94a3b8;
  font-size: 21rpx;
  font-weight: 700;
}

.node-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.score-wrap {
  flex: none;
  text-align: right;
}

.score {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.original-score {
  margin-top: 4rpx;
  color: #94a3b8;
  font-size: 18rpx;
  text-decoration: line-through;
}

.confidence-track {
  height: 12rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.confidence-fill {
  height: 100%;
  background: #111827;
  border-radius: 999rpx;
  transition: width .25s ease;
}

.reason {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.feedback-block {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f1f5f9;
}

.feedback-question {
  color: #475569;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.feedback-button {
  flex: 1;
  height: 60rpx;
  padding: 0 8rpx;
  margin: 0;
  color: #64748b;
  background: #f8fafc;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.feedback-button.accurate.active {
  color: #166534;
  background: #dcfce7;
}

.feedback-button.unsure.active {
  color: #92400e;
  background: #fef3c7;
}

.feedback-button.inaccurate.active {
  color: #991b1b;
  background: #fee2e2;
}

.feedback-result {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.55;
}

.feedback-summary {
  margin-top: 26rpx;
}

.feedback-summary-title {
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
}

.feedback-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.feedback-summary-grid > view {
  padding: 18rpx 12rpx;
  text-align: center;
  background: #f8fafc;
  border-radius: 16rpx;
  color: #64748b;
  font-size: 20rpx;
}

.feedback-stat-number {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.feedback-summary-note {
  margin-top: 16rpx;
  font-size: 20rpx;
}

.disclaimer {
  margin-top: 28rpx;
}

.disclaimer-title {
  margin-bottom: 10rpx;
  font-weight: 700;
}
