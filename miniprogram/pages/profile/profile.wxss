.step {
  margin-bottom: 14rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.intro-card {
  margin-bottom: 20rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
}

.summary-number {
  font-size: 42rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 8rpx;
  color: #7c8592;
  font-size: 21rpx;
}

.summary-divider {
  width: 2rpx;
  height: 68rpx;
  background: #edf0f4;
}

.graph-card {
  padding: 0;
  overflow: hidden;
}

.graph-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 30rpx 0;
}

.layer-title,
.detail-title {
  color: #334155;
  font-size: 28rpx;
  font-weight: 800;
}

.graph-subtitle {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.replay-button {
  min-width: 116rpx;
  height: 58rpx;
  padding: 0 20rpx;
  margin: 0;
  color: #475569;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.replay-button::after {
  border: none;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 30rpx 20rpx;
  color: #64748b;
  font-size: 21rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.input-dot {
  background: #111827;
}

.inference-dot {
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
}

.dimension-dot {
  background: #f3e8ff;
  border: 2rpx solid #a855f7;
}

.graph-scroll {
  width: 100%;
  border-top: 2rpx solid #f1f5f9;
  border-bottom: 2rpx solid #f1f5f9;
  background: #f8fafc;
}

.graph-canvas {
  display: block;
  background: #f8fafc;
}

.graph-status {
  padding: 18rpx 30rpx 22rpx;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 700;
}

.graph-status.done {
  color: #64748b;
}

.detail-title {
  margin: 34rpx 0 18rpx;
}

.node-card {
  position: relative;
  padding: 28rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border: 2rpx solid #eef1f5;
  border-radius: 24rpx;
}

.node-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #cbd5e1;
}

.depth-1::before { background: #6366f1; }
.depth-2::before { background: #8b5cf6; }
.depth-3::before { background: #a855f7; }

.node-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.node-main {
  flex: 1;
  min-width: 0;
}

.depth-label {
  color: #94a3b8;
  font-size: 21rpx;
  font-weight: 700;
}

.node-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.score {
  flex: none;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.confidence-track {
  height: 12rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #eef2f7;
  border-radius: 999rpx;
}

.confidence-fill {
  height: 100%;
  background: #111827;
  border-radius: 999rpx;
}

.reason {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.65;
}

.disclaimer {
  margin-top: 28rpx;
}

.disclaimer-title {
  margin-bottom: 10rpx;
  font-weight: 700;
}
