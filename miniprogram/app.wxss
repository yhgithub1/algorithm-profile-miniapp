page {
  background: #f6f7fb;
  color: #171a21;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(17, 24, 39, 0.06);
}

.h1 {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.h2 {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.muted {
  color: #737b87;
  line-height: 1.7;
}

.primary {
  margin-top: 28rpx;
  background: #111827;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag {
  display: inline-block;
  padding: 16rpx 22rpx;
  margin: 10rpx 10rpx 0 0;
  background: #eef1f6;
  border-radius: 999rpx;
  color: #434a54;
}

.tag.active {
  background: #111827;
  color: #ffffff;
}
